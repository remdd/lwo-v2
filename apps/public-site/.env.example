# Database (Supabase - pooled connection)
# Add ?pgbouncer=true for transaction pooler compatibility
DATABASE_URL="postgresql://postgres.PROJECT_ID:[PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Strapi CMS
NEXT_PUBLIC_STRAPI_URL="http://localhost:1337"
STRAPI_API_TOKEN="your-strapi-api-token"

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sandbox-client-id"
PAYPAL_CLIENT_SECRET="sandbox-client-secret"
PAYPAL_MODE="sandbox"

# Email (Mailgun)
MAILGUN_API_KEY="your-mailgun-api-key"
MAILGUN_DOMAIN="your-domain.mailgun.org"
MAILGUN_FROM_EMAIL="noreply@wildlifeoasis.co.uk"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# App Config
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
