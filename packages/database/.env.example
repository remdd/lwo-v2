# Database connection string
# Use Supabase connection pooling URL for best performance

# Development/UAT Database (lwo-dev Supabase project)
# Transaction pooler for app queries (port 6543) - pgbouncer=true disables prepared statements
DATABASE_URL="postgresql://postgres.PROJECT_ID:[PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (needed for migrations)
# Session pooler for migrations (port 5432)
DIRECT_URL="postgresql://postgres.PROJECT_ID:[PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"
